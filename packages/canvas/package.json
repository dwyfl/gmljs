{
  "name": "@gmljs/canvas",
  "version": "0.0.0",
  "description": "A fast, portable, pure-TypeScript Canvas 2D rasterizer.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": "./dist/node.mjs",
      "default": "./dist/browser.mjs"
    },
    "./browser": "./dist/browser.mjs",
    "./core": "./dist/core.mjs",
    "./node": "./dist/node.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "bumpp": "^12.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "skia-canvas": "^3.0.8",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
