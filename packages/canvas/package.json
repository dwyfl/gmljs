{
  "name": "@gmljs/canvas",
  "version": "1.0.0-beta.0",
  "description": "A fast, portable, pure-TypeScript Canvas 2D rasterizer.",
  "homepage": "https://github.com/dwyfl/gmljs",
  "bugs": {
    "url": "https://github.com/dwyfl/gmljs/issues"
  },
  "license": "MIT",
  "author": "Gustav Peterz <gpeterz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwyfl/gmljs.git",
    "directory": "packages/canvas"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "default": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "bench:jpeg": "node --experimental-strip-types scripts/jpeg-bench.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "skia-canvas": "^4.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
