{
  "name": "@gmljs/render",
  "version": "1.0.0-beta.0",
  "description": "Library for rendering GML documents.",
  "homepage": "https://github.com/dwyfl/gmljs",
  "bugs": {
    "url": "https://github.com/dwyfl/gmljs/issues"
  },
  "license": "MIT",
  "author": "Gustav Peterz <gpeterz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwyfl/gmljs.git",
    "directory": "packages/render"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./video": {
      "types": "./dist/video.d.mts",
      "default": "./dist/video.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "bench": "node scripts/bench.ts",
    "bench:gml": "node scripts/gml-bench.ts",
    "examples:gml": "node scripts/gml-examples.ts",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "@gmljs/canvas": "workspace:^",
    "@gmljs/core": "workspace:^",
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "canvas": "^3.2.3",
    "mediabunny": "^1.61.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "pureimage": "^0.4.20",
    "skia-canvas": "^4.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "canvas": "^3.2.3",
    "mediabunny": "^1.61.3",
    "pureimage": "^0.4.20",
    "skia-canvas": "^3.0.8 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    },
    "mediabunny": {
      "optional": true
    },
    "pureimage": {
      "optional": true
    },
    "skia-canvas": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
