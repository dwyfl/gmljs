    "bumpp": "^12.3.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0"
