{
  "name": "gmljs-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run -r build && vp check && vp run -r test",
    "dev": "vp run -r --parallel dev",
    "prepare": "vp config",
    "changeset": "changeset",
    "release": "vp run ready && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
